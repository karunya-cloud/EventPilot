# -------------------------------------------------------------
# EventPilot AI - Environment Configuration
# -------------------------------------------------------------

# Environment: development | testing | production
APP_ENV=development
DEBUG=True

# Database Configuration (MySQL 8 with automatic SQLite fallback for frictionless testing)
# Default MySQL connection:
DATABASE_URL=mysql+pymysql://eventpilot:eventpilot123@localhost:3306/eventpilot_db
# For SQLite local fallback, uncomment:
# DATABASE_URL=sqlite:///./eventpilot.db

# Agentverse and Fetch.ai uAgents Configuration
AGENTVERSE_API_KEY=your_agentverse_api_key_here
COORDINATOR_SEED=eventpilot_coordinator_agent_seed_phrase_secure_2026
PLANNING_SEED=eventpilot_planning_agent_seed_phrase_secure_2026
LOGISTICS_SEED=eventpilot_logistics_agent_seed_phrase_secure_2026
REGISTRATION_SEED=eventpilot_registration_agent_seed_phrase_secure_2026
COMMUNICATION_SEED=eventpilot_communication_agent_seed_phrase_secure_2026
RISK_SEED=eventpilot_risk_agent_seed_phrase_secure_2026

# Agent Network Ports
COORDINATOR_PORT=8000
PLANNING_PORT=8001
LOGISTICS_PORT=8002
REGISTRATION_PORT=8003
COMMUNICATION_PORT=8004
RISK_PORT=8005

# REST API & Dashboard
API_PORT=8080
API_HOST=0.0.0.0

# LLM Configuration (ASI / OpenAI / Compatible)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Communication & Security
MOCK_EXTERNAL_ACTIONS=True
ALLOW_AUTO_EMAIL=False
QR_SIGNING_SECRET=eventpilot_jwt_and_qr_hmac_secret_key_32_bytes_min
